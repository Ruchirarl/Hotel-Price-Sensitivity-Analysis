colnames(Expedia)[which(colnames(Expedia) == "Booked?")] <- "Booked"

ggplot(Expedia, aes(x = PricePerNight, y = Booked, color = Region)) + 
  geom_point() +  # Scatter plot points
  geom_smooth(method = "lm", se = FALSE) +  # Linear regression line
  labs(title = "Price Per Night vs Booking Likelihood",
       x = "Price Per Night",
       y = "Booked (0 = No, 1 = Yes)") +
  theme_minimal()  # Apply a clean theme


