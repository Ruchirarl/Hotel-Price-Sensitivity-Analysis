###if we create income groups and run regression:
Expedia$IncomeGroup <- cut(Expedia$UserIncome, 
                           breaks = c(-Inf, 40000, 80000, Inf), 
                           labels = c("Low", "Medium", "High"))

# View the distribution of income groups
table(Expedia$IncomeGroup)
Expedia$IncomeGroup <- cut(Expedia$UserIncome, 
                           breaks = c(-Inf, 40000, 80000, Inf), 
                           labels = c("Low", "Medium", "High"))

# Step 3: Run the regression with the interaction terms and new IncomeGroup variable
model2 <- lm(Booked ~ Region + PricePerNight * IncomeGroup + PricePerNight * Region, data = Expedia)

# Display the summary of the model
summary(model2)

# Exponential Form
#running regression:
model3 <- lm(Booked ~ Region + exp(PricePerNight) * UserIncome + exp(PricePerNight) * Region, data = Expedia)

# Displaying the summary of the model
summary(model3)


# Step 3: Run the regression with the interaction terms and new IncomeGroup variable
model4 <- lm(Booked ~ Region + exp(PricePerNight) * IncomeGroup + exp(PricePerNight) * Region, data = Expedia)

# Display the summary of the model
summary(model4)


# Polynomial regression with quadratic and cubic terms for PricePerNight
model_poly <- lm(Booked ~ Region + poly(PricePerNight, 3) * UserIncome + poly(PricePerNight, 3) * Region, data = Expedia)

# Display the summary of the model
summary(model_poly)




